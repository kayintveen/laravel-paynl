{
    "name": "deniztezcan/laravel-paynl",
    "description": "Laravel wrapper for Pay.nl PHP SDK (L12-compat fork)",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/deniztezcan/laravel-paynl",
    "authors": [
        {
            "name": "Deniz Tezcan",
            "email": "deniz@nopulp.nl"
        }
    ],
    "autoload": {
        "psr-4": {
            "DenizTezcan\\LaravelPayNL\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^11.0|^12.0",
        "paynl/sdk": "2.*.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "DenizTezcan\\LaravelPayNL\\PayNLServiceProvider"
            ],
            "aliases": {
                "PayNL": "DenizTezcan\\LaravelPayNL\\Facades\\PayNL"
            }
        }
    }
}
